{
  // The Next app as its own Worker, built by OpenNext. James's API Worker is `nest` in cloud/.
  // Served on fredandginger.jamesjuliusdarby.com through nest's WEB service binding: nest keeps /api, /login,
  // /logout and /hooks and hands every other path here. Deploy this before nest the first time.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fred-web",
  "main": "worker.ts",   // OpenNext's .open-next/worker.js, wrapped with Sentry
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" }
}
